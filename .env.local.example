# Supabase (required)
# Copy this file to `.env.local` and fill in values from your Supabase project:
# Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public anon / publishable key. Safe to expose in the browser.
# Never put the service-role key in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Absolute site origin used for OAuth and email redirectTo URLs.
# Local: http://localhost:3000 (also the automatic fallback in development)
# Production: https://YOUR_DEPLOYMENT.vercel.app (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
